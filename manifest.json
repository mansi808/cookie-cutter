{
  "name": "Cookie Cutter",
  "description": "Rejects Cookie Banners",
  "version": "1.1.9",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "16"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["scripts/cookieBannerIdAttributes2.js",
        "scripts/cookieBannerIdAttributes.js","scripts/content.js"]
    }
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
 "permissions": [
    "declarativeNetRequest",
    "storage"  
  ],
  "icons": {
    "16": "images/cookie_icon.png",
    "32": "images/cookie_icon.png",
    "48" : "images/cookie_icon.png",
    "128": "images/cookie_icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }

}

